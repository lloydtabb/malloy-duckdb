no_such_table

# Ordinary SQL still works
query I
SELECT count(*) FROM flights;
----
3

# With the override turned off, Malloy statements explain how to turn it on
statement ok
SET allow_parser_override_extension = 'default';

statement error
run: flights -> by_carrier
----
allow_parser_override_extension
