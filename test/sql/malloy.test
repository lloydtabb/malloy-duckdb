# name: test/sql/malloy.test
# description: Malloy in DuckDB: embedded queries, the session model, installed models
# group: [sql]

statement error
SELECT * FROM malloy('run: flights -> by_carrier');
----
Catalog Error

require malloy

statement ok
CREATE TABLE flights AS
SELECT * FROM (VALUES ('AA', 'JFK', 100), ('AA', 'LAX', 200), ('UA', 'JFK', 300)) AS t(carrier, origin, distance);

statement ok
CREATE TABLE carrier_names AS
SELECT * FROM (VALUES ('AA', 'American'), ('UA', 'United')) AS t(code, nickname);

statement ok
CREATE TABLE movies AS
SELECT * FROM (VALUES
  ('Alien', ['Horror', 'SciFi'], [{'name': 'Scott', 'born': 1937}]),
  ('Heat', ['Crime'], [{'name': 'Mann', 'born': 1943}]),
  ('Blade Runner', ['SciFi'], [{'name': 'Scott', 'born': 1937}])
) AS t(title, genres, directors);

# --- Embedded Malloy, no model ---------------------------------------------

query II
SELECT * FROM %{ duckdb.table('flights') -> { group_by: carrier; aggregate: total is distance.sum() } }% ORDER BY carrier;
----
AA	300
UA	300

query II
run: duckdb.table('flights') -> { group_by: carrier; aggregate: n is count(); order_by: carrier };
----
AA	2
UA	1

query I
SELECT malloy_version IS NOT NULL FROM malloy_version();
----
true

query I
SELECT count(*) > 10 FROM malloy_help();
----
true

# --- Help topics (malloyyo's yo_help topics) ---------------------------------------

query I
SELECT count(*) > 10 FROM malloy_help_topics() WHERE topic LIKE 'language/%';
----
true

# A topic by part of its name; its name comes first
query I
SELECT help FROM malloy_help_topic('joins') LIMIT 1;
----
language/joins

query I
SELECT count(*) > 5 FROM malloy_help_topic('language/aggregate-locality-symmetric-aggregates');
----
true

statement error
malloy help no_such_topic_anywhere;
----
No help topic matches

# --- The session model --------------------------------------------------------

query II
malloy import 'test/models/flights.malloy';
----
source	flights

query III
run: flights -> by_carrier + { order_by: nickname };
----
American	2	300
United	1	300

# Embedded queries go anywhere a table can, and compose with SQL
query I
SELECT nickname FROM %{ flights -> by_carrier }% WHERE flight_count > 1;
----
American

query I
SELECT count(*) FROM (%{ flights -> by_carrier }%) AS f JOIN carrier_names AS c ON c.nickname = f.nickname;
----
2

query I
SELECT (SELECT max(flight_count) FROM %{ flights -> by_carrier }%) + (SELECT count(*) FROM %{ flights -> by_carrier }%);
----
4

query I
SELECT sql LIKE 'SELECT nickname FROM (SELECT %' FROM malloy_sql('SELECT nickname FROM %{ flights -> by_carrier }%');
----
true

query II
source: long_flights is flights extend { where: distance > 150 };
----
source	long_flights

query II
query: busy is flights -> by_carrier;
----
query	busy

query I
run: long_flights -> { aggregate: flight_count };
----
2

query I
SELECT count(*) FROM malloy_session();
----
3

# A statement that does not compile is not added
statement error
source: bad is flights extend { dimension: x is no_such_column };
----
'no_such_column' is not defined

query I
SELECT count(*) FROM malloy_session();
----
3

query III
SELECT name, kind, "from" FROM malloy_sources();
----
busy	query	session
flights	source	session
long_flights	source	session

# --- describe and nested types -------------------------------------------------

query II
malloy import 'test/models/movies.malloy';
----
source	movies

query IIII
SELECT name, kind, type, grain FROM malloy_describe('movies');
----
title	dimension	string	(empty)
movie_count	measure	number	(empty)
genres	dimension	string[]	(empty)
directors	dimension	{name :: string, born :: number}[]	(empty)
by_genre	view	view	(empty)
by_genre_each	view	view	(empty)
by_director	view	view	(empty)
genres.each	dimension	string	genres
directors.name	dimension	string	directors
directors.born	dimension	number	directors

query II
SELECT definition, example FROM malloy_describe('movies') WHERE name = 'movie_count';
----
count()	aggregate: movie_count

query II
run: movies -> by_genre + { order_by: genre };
----
Crime	1
Horror	1
SciFi	2

query II
run: movies -> by_director + { order_by: director };
----
Mann	1
Scott	2

statement error
malloy describe nope;
----
no source or query named 'nope'

statement ok
malloy reset;

query I
SELECT count(*) FROM malloy_session();
----
0

# --- Installing a model ------------------------------------------------------------

query II
malloy check 'test/models/airline/airline.malloy';
----
airline_flights	source
top_carriers	query

query III
malloy install 'test/models/airline/airline.malloy';
----
airline_flights	source	airline/airline.malloy
top_carriers	query	airline/airline.malloy

# The model and the file it imports from ../shared are both stored
query II
SELECT model, path FROM malloy.files ORDER BY path;
----
airline/airline.malloy	airline/airline.malloy
airline/airline.malloy	shared/carrier_names.malloy

query III
SELECT name, kind, "from" FROM malloy_sources();
----
airline_flights	source	memory: airline/airline.malloy
top_carriers	query	memory: airline/airline.malloy

# Descriptions, joins and what's reached through them
query III
SELECT description, primary_key, joins FROM malloy_sources() WHERE name = 'airline_flights';
----
Flights, one row per flight	(empty)	carrier_names (one)

query IIII
SELECT name, kind, description, example FROM malloy_describe('airline_flights') WHERE name LIKE 'carrier_names%';
----
carrier_names	join	Carrier names, one row per carrier code	group_by: carrier_names.code
carrier_names.code	dimension	(empty)	group_by: carrier_names.code; aggregate: n is count(carrier_names.code)
carrier_names.nickname	dimension	(empty)	group_by: carrier_names.nickname; aggregate: n is count(carrier_names.nickname)
carrier_names.shouted	dimension	The carrier's name in capitals	group_by: carrier_names.shouted; aggregate: n is count(carrier_names.shouted)

query II
run: airline_flights -> by_carrier + { order_by: nickname };
----
American	2
United	1

query II
SELECT * FROM %{ top_carriers }% ORDER BY nickname;
----
American	2
United	1

# A session definition built on an installed source
query II
source: aa_flights is airline_flights extend { where: carrier = 'AA' };
----
source	aa_flights

query I
run: aa_flights -> { aggregate: flight_count };
----
2

statement ok
malloy reset;

# Installing again replaces the model
query III
malloy install 'test/models/airline/airline.malloy';
----
airline_flights	source	airline/airline.malloy
top_carriers	query	airline/airline.malloy

query I
SELECT count(*) FROM malloy.sources;
----
2

query III
malloy update;
----
airline_flights	source	airline/airline.malloy
top_carriers	query	airline/airline.malloy

# A model that reads a file by a relative path installs, with a warning
query III
SELECT name LIKE 'reads the file%', kind, model FROM malloy_install('test/models/local/local_data.malloy') ORDER BY kind;
----
false	source	local_data.malloy
true	warning	local_data.malloy

# Removing one source, then a whole model
query I
malloy uninstall top_carriers;
----
top_carriers

query I
SELECT name FROM malloy.sources ORDER BY name;
----
airline_flights
local_numbers

query I
malloy uninstall 'airline/airline.malloy';
----
airline_flights

query I
SELECT count(*) FROM malloy.files WHERE model = 'airline/airline.malloy';
----
0

statement error
run: airline_flights -> by_carrier;
----
airline_flights

