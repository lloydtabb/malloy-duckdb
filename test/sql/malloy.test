# name: test/sql/malloy.test
# description: query DuckDB with Malloy
# group: [sql]

statement error
SELECT * FROM malloy('run: flights -> by_carrier');
----
Catalog Error

require malloy

statement ok
CREATE TABLE flights AS
SELECT * FROM (VALUES ('AA', 'JFK', 100), ('AA', 'LAX', 200), ('UA', 'JFK', 300)) AS t(carrier, origin, distance);

statement ok
CREATE TABLE movies AS
SELECT * FROM (VALUES
  ('Alien', ['Horror', 'SciFi'], [{'name': 'Scott', 'born': 1937}]),
  ('Heat', ['Crime'], [{'name': 'Mann', 'born': 1943}]),
  ('Blade Runner', ['SciFi'], [{'name': 'Scott', 'born': 1937}])
) AS t(title, genres, directors);

# --- No model: queries can name tables directly ---------------------------

query II
SELECT * FROM malloy('run: duckdb.table(''flights'') -> { group_by: carrier; aggregate: total is distance.sum() }') ORDER BY carrier;
----
AA	300
UA	300

query I
SELECT malloy_version IS NOT NULL FROM malloy_version();
----
true

# --- The session model: import, source:, query: ---------------------------

query II
SELECT * FROM malloy_load('test/models/flights.malloy');
----
source	flights

query III
SELECT * FROM malloy('run: flights -> by_carrier') ORDER BY nickname;
----
American	2	300
United	1	300

query I
SELECT nickname FROM malloy('run: flights -> by_carrier') WHERE flight_count > 1;
----
American

query I
SELECT sql LIKE '%LEFT JOIN%' FROM malloy_sql('run: flights -> by_carrier');
----
true

# Statements typed directly (LOAD turned on the parser override)
query II
import 'test/models/movies.malloy';
----
source	movies

query II
source: long_flights is flights extend { where: distance > 150 };
----
source	long_flights

query II
query: busy is flights -> by_carrier;
----
query	busy

query I
run: long_flights -> { aggregate: flight_count };
----
2

query II
SELECT * FROM malloy_sources() ORDER BY name;
----
busy	query
flights	source
long_flights	source
movies	source

query I
show: sources;
----
flights
long_flights
movies

query I
show: queries;
----
busy

query I
SELECT count(*) FROM malloy_session();
----
4

# A statement that does not compile is not added
statement error
source: bad is flights extend { dimension: x is no_such_column };
----
'no_such_column' is not defined

query I
SELECT count(*) FROM malloy_session();
----
4

# --- describe ---------------------------------------------------------------

query III
describe source movies;
----
title	dimension	string
movie_count	measure	number
genres	dimension	string[]
directors	dimension	{name :: string, born :: number}[]
by_genre	view	view
by_genre_each	view	view
by_director	view	view

statement error
describe source nope;
----
No source or query named 'nope'

# --- Nested DuckDB types ----------------------------------------------------

query II
run: movies -> by_genre + { order_by: genre };
----
Crime	1
Horror	1
SciFi	2

query II
run: movies -> by_genre_each + { order_by: genre };
----
Crime	1
Horror	1
SciFi	2

query II
run: movies -> by_director + { order_by: director };
----
Mann	1
Scott	2

# --- A model given per call, instead of the session model -------------------

query I
SELECT c FROM malloy('run: carriers -> { aggregate: c is count() }', model := 'test/models/carriers.malloy');
----
2

# Temporary tables are visible to Malloy
statement ok
CREATE TEMP TABLE scratch AS SELECT 42 AS answer;

query I
SELECT * FROM malloy('run: duckdb.table(''scratch'') -> { select: answer }');
----
42

# --- Errors -----------------------------------------------------------------

statement error
SELECT * FROM malloy('run: flights -> no_such_view');
----
'no_such_view' is not defined

statement error
SELECT * FROM malloy_load('test/models/no_such_model.malloy');
----
no_such_model.malloy

statement error
SELECT * FROM malloy('run: duckdb.table(''no_such_table'') -> { aggregate: c is count() }');
----
no_such_table

# Ordinary SQL still works with the override on
query I
SELECT count(*) FROM flights;
----
3

# With the override turned off, Malloy statements explain how to turn it on
statement ok
SET allow_parser_override_extension = 'default';

statement error
run: flights -> by_carrier
----
allow_parser_override_extension
